# GPT Newspaper Environment Configuration
# Copy this file to .env and fill in your actual values

# Port Configuration (Optional - defaults provided)
FRONTEND_PORT=5000
BACKEND_PORT=8000

# Model Provider Configuration
# MODEL_PROVIDER options: openai, openrouter, google (google not yet implemented)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o

# API Keys - Configure based on your chosen provider
# For OpenAI (default)
OPENAI_API_KEY=your_openai_api_key_here

# For OpenRouter (uncomment if using MODEL_PROVIDER=openrouter)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# For Google (placeholder - not yet implemented)
# GOOGLE_API_KEY=your_google_api_key_here

# Required for news search functionality
TAVILY_API_KEY=your_tavily_api_key_here

# Application Configuration (Optional)
# Uncomment and modify as needed
# LOG_LEVEL=INFO
# DEBUG=False