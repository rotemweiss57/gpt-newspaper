# Required: Tavily powers the news search (https://tavily.com)
TAVILY_API_KEY=<your-tavily-api-key>

# Any LangChain chat model, written as "<provider>:<model>".
# Examples: openai:gpt-5.4-mini | anthropic:claude-sonnet-5-5 | google_genai:gemini-2.5-flash
#           ollama:llama3.1 | groq:llama-3.3-70b-versatile
LLM_MODEL=openai:gpt-5.4-mini

# Set the key for the provider you picked above
OPENAI_API_KEY=<your-openai-api-key>
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# Optional tuning
# LLM_TEMPERATURE=0.3
# MAX_REVISIONS=2          # writer <-> critique rounds per article
# SOURCES_PER_ARTICLE=5    # sources the curator keeps
# NEWS_TIME_RANGE=week     # day | week | month | year
# ALLOW_MODEL_OVERRIDE=true  # let the web UI choose a different model per run
# PORT=8000
