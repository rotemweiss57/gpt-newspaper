# GPT Newspaper Environment Configuration
# Copy this file to .env and fill in your actual values

# Port Configuration (Optional - defaults provided)
FRONTEND_PORT=5000
BACKEND_PORT=8000

# Model Provider Configuration
# MODEL_PROVIDER options: openai (original), openrouter (tested)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o

# API Keys - Configure based on your chosen provider
# For OpenAI (original implementation, replaces deprecated gpt-4-0125-preview)
OPENAI_API_KEY=your_openai_api_key_here

# For OpenRouter (tested with models below)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Tested OpenRouter models: openai/gpt-4o, google/gemini-2.5-pro

# Required for news search functionality
TAVILY_API_KEY=your_tavily_api_key_here

# Application Configuration (Optional)
# Uncomment and modify as needed
# LOG_LEVEL=INFO
# DEBUG=False