# Everything here is optional: you can also enter keys in the web UI ("Model & API keys").
# Keys set here are used for everyone who uses this server.

# Tavily powers the news search (free key at https://tavily.com)
TAVILY_API_KEY=

# Any LangChain chat model, written as "<provider>:<model>".
# Examples: openai:gpt-5.4-mini | anthropic:claude-sonnet-5-5 | google_genai:gemini-2.5-flash
#           ollama:llama3.1 | groq:llama-3.3-70b-versatile
LLM_MODEL=openai:gpt-5.4-mini

# The key for the provider you picked above
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# Illustrations: ink | engraving | risograph | photos (use the news sources' photos instead)
# IMAGE_STYLE=ink
# IMAGE_MODEL=openai:gpt-image-2
# IMAGE_QUALITY=medium        # low | medium | high

# Newsroom tuning
# SEARCHES_PER_TOPIC=2        # searches the assignment editor plans per topic (1 = just the topic)
# SOURCES_PER_ARTICLE=5       # sources the curator keeps
# MAX_REVISIONS=2             # writer <-> critic rounds per article
# NEWS_TIME_RANGE=week        # day | week | month | year (widened automatically if nothing is found)
# LLM_TEMPERATURE=            # leave unset for the provider default

# Server
# PORT=8000
# ALLOW_MODEL_OVERRIDE=true   # let visitors pick a different model per edition
# MAX_CONCURRENT_EDITIONS=4

# Optional: trace every agent step in LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
